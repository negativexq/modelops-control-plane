{
  "name": "modelops-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "e2e": "playwright test",
    "gen:api": "npm run gen:api:schema && npm run gen:api:types",
    "gen:api:schema": "cd ../backend && ${PYTHON:-.venv/bin/python} -m scripts.export_openapi",
    "gen:api:types": "openapi-typescript openapi.json -o src/lib/api-schema.ts --default-non-nullable=false"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.80.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.2.1",
    "shadcn": "^4.23.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
